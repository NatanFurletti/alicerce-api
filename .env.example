# Copie para .env: cp .env.example .env
# O .env nunca é versionado. Este arquivo é o contrato de configuração da aplicação.

# ─── Aplicação ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Banco de dados ───────────────────────────────────────────────────────────
POSTGRES_USER=alicerce
POSTGRES_PASSWORD=alicerce
POSTGRES_DB=alicerce
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

DATABASE_URL="postgresql://alicerce:alicerce@localhost:5432/alicerce?schema=public"
# Usado apenas por npm run test:e2e — aponta para o container efêmero (tmpfs).
DATABASE_URL_TEST="postgresql://alicerce:alicerce@localhost:5433/alicerce_test?schema=public"

# ─── Autenticação (Etapa 4) ───────────────────────────────────────────────────
# Gere um segredo real com: openssl rand -base64 32
JWT_ACCESS_SECRET=troque-este-valor-em-producao
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=troque-este-valor-tambem
JWT_REFRESH_TTL=7d

# ─── Parâmetros de mercado (defaults de referência) ───────────────────────────
# ATENÇÃO: valores de referência para simulação, NÃO fatos regulatórios.
# Verifique a vigência junto ao agente financeiro antes de usar como base real.

# LTV máximo — percentual do valor do imóvel passível de financiamento.
MAX_LTV_PERCENT=80
# Comprometimento máximo da renda bruta familiar com a primeira parcela.
MAX_INCOME_COMMITMENT_PERCENT=30
# Prazo máximo do financiamento, em meses (35 anos).
MAX_TERM_MONTHS=420

# Alíquota mensal do MIP (morte e invalidez permanente), sobre o saldo devedor.
DEFAULT_MIP_MONTHLY_RATE=0.00025
# Alíquota mensal do DFI (danos físicos ao imóvel), sobre o valor do imóvel.
DEFAULT_DFI_MONTHLY_RATE=0.00005
# Taxa de administração mensal, em centavos (2500 = R$ 25,00).
DEFAULT_ADMIN_FEE_CENTS=2500
